{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "server",
	"compatibility_date": "2025-08-03",
	"main": "./src/index.ts",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true,
		},
	},
	"routes": [
		{
			"pattern": "webhook.nepaliecochat.bot",
			"zone_name": "nepaliecochat.bot",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"queues": {
    "producers": [
      {
        "queue": "whatsapp-queue",
        "binding": "WHATSAPP_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "whatsapp-queue",
        "max_batch_size": 1,
        "max_batch_timeout": 5
      }
    ]
  }
}
