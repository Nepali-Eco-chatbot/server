{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "server",
	"compatibility_date": "2025-08-03",
	"main": "./src/index.ts",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true,
		},
	},
	"routes": [
		{
			"pattern": "webhook.nepaliecochat.bot",
			"zone_name": "nepaliecochat.bot",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
}
